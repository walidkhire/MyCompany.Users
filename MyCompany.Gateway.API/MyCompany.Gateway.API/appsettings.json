{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "VotreCleSecreteSuperLongueEtSecuriseeIci123!",
    "Issuer": "MyCompany.Identity",
    "Audience": "MyCompany.Apps"
  },
  "ReverseProxy": {
    "Routes": {
      "produits-route": {
        "ClusterId": "users-cluster",
        "CorsPolicy": "MonFrontendPolicy",
        "Match": {
          "Path": "/produits/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/produits/{remainder}" }
        ]
      },
     
      "users-route": {
        "ClusterId": "users-cluster",
        "CorsPolicy": "MonFrontendPolicy", //  green
        "Match": {
          "Path": "/users/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/users/{remainder}" }
        ]
      },



      "orders-route": {
        "ClusterId": "orders-cluster",
        "CorsPolicy": "MonFrontendPolicy",
        "Match": {
          "Path": "/orders/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/orders/{remainder}" }
        ]
      },
      "auths-route": {
        "ClusterId": "auths-cluster",
        "CorsPolicy": "MonFrontendPolicy",
        "Match": {
          "Path": "/auths/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/auths/{remainder}" }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-destination": {
            "Address": "https://localhost:7070/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders-destination": {
            "Address": "https://localhost:7259/"
          }
        }
      },
      "auths-cluster": {
        "Destinations": {
          "auths-destination": {
            "Address": "https://localhost:7070/"
          }
        }
      }
    }
  }
}
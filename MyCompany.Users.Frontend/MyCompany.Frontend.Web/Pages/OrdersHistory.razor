@page "/orders-history"
@using MyCompany.Frontend.Web.Models
@inject HttpClient Http
@inject MyCompany.Frontend.Web.Services.ToastService Toast

<PageTitle>Mes Commandes - MyCompany</PageTitle>

<div class="row justify-content-center">
    <div class="col-xl-10">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">📦 Historique des Commandes</h2>
                <p class="text-muted mb-0">Consultation des messages persistés et routés via la Gateway YARP.</p>
            </div>
            <button class="btn btn-outline-primary d-flex align-items-center gap-2 shadow-sm" @onclick="LoadOrders" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>🔄 Actualiser</span>
                }
            </button>
        </div>

        @if (isLoading && orders == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                <p class="text-secondary fw-bold">Récupération des commandes depuis le microservice...</p>
            </div>
        }
        else if (orders != null && !orders.Any())
        {
            <div class="alert alert-warning border-0 shadow-sm p-4 text-center">
                <span class="fs-1">🛒</span>
                <h4 class="mt-3 fw-bold">Aucune commande trouvée</h4>
                <p class="text-muted mb-0">Revenez sur la page d'accueil pour publier votre première transaction.</p>
            </div>
        }
        else if (orders != null)
        {
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 bg-white">
                        <thead class="table-light text-secondary uppercase border-bottom">
                            <tr>
                                <th class="p-3">Détails de la Commande</th>
                                <th class="p-3">Livraison & Paiement</th>
                                <th class="p-3">Dates</th>
                                <th class="p-3 text-end">Montant Total</th>
                                <th class="p-3 text-center">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in orders)
                            {
                                <tr>
                                    <td class="p-3">
                                        <div class="fw-bold text-dark mb-1">Commande</div>
                                        <span class="font-monospace text-muted small bg-light p-1 rounded">@order.Id</span>
                                    </td>

                                    <td class="p-3">
                                        <div class="small text-dark fw-semibold">📍 @order.ShippingAddress</div>
                                        <div class="small text-muted mt-1">
                                            @GetPaymentDisplay(order.PaymentMethod)
                                        </div>
                                    </td>

                                    <td class="p-3 small">
                                        <div><strong>Créée le :</strong> @order.CreatedAt.ToLocalTime().ToString("g")</div>
                                        <div class="text-muted"><strong>MàJ :</strong> @order.LastUpdatedAt.ToLocalTime().ToString("t")</div>
                                    </td>

                                    <td class="p-3 text-end fw-bold text-dark fs-5">@order.Total.ToString("C2")</td>

                                    <td class="p-3 text-center">
                                        <span class="badge px-3 py-2 rounded-pill fw-bold @GetStatusBadgeClass(order.Status)">
                                            ● @(order.Status.ToLower() switch
                                            {
                                                "validated" => "Validée",
                                                "pending" => "En Attente",
                                                "rejected" => "Rejetée",
                                                _ => order.Status
                                            })
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</div>

@code {
    private List<OrderDto>? orders;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;

        try
        {
            var result = await Http.GetFromJsonAsync<List<OrderDto>>("orders");

            if (result != null)
            {
                orders = result;
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Erreur réseau lors de la récupération : {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "validated" or "validée" => "bg-success-subtle text-success border border-success-subtle",
            "pending" or "en attente" => "bg-warning-subtle text-warning border border-warning-subtle",
            "rejected" or "rejetée" or "annulée" => "bg-danger-subtle text-danger border border-danger-subtle",
            _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
        };
    }

    private string GetPaymentDisplay(string paymentMethod)
    {
        return paymentMethod.ToLower() switch
        {
            "creditcard" or "credit_card" => "💳 Via Carte Bancaire",
            "paypal" => "🅿️ Via PayPal",
            "banktransfer" => "🏦 Via Virement Bancaire",
            "applepay" => "🍏 Via Apple Pay",
            _ => "❓ Mode de paiement inconnu"
        };
    }
}
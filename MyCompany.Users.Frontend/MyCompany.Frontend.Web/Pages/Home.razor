@page "/"

@using MyCompany.Frontend.Web.Models
@using MyCompany.Frontend.Web.Services
@inject IHttpClientFactory HttpClientFactory // 🟢 On injecte la factory

@inject HttpClient Http
@inject AuthService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthProvider
@inject ToastService Toast

<PageTitle>Dashboard - MyCompany</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="row justify-content-center">
            <div class="col-xl-9 col-lg-10">

                <div class="p-5 mb-4 bg-light border rounded-3 shadow-sm">
                    <div class="container-fluid py-2">
                        <h1 class="display-5 fw-bold text-dark">Bonjour @context.User.Identity?.Name !</h1>
                        <p class="col-md-12 fs-5 text-muted mt-3">
                            Bienvenue sur votre espace de gestion d'architecture microservices.
                        </p>
                        <hr class="my-4" />
                        <p class="small text-secondary mb-0">
                            💡 Utilisez le menu supérieur pour consulter <strong>Mes Commandes</strong> en temps réel.
                        </p>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3 fw-bold fs-5">
                        🛒 Créer une nouvelle commande (Orders.API)
                    </div>
                    <div class="card-body p-4 bg-white">

                        <EditForm Model="@orderModel" OnValidSubmit="HandleValidSubmit" Context="orderContext">
                            <DataAnnotationsValidator />

                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary fs-6">Montant de la transaction (€)</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light fw-bold">€</span>
                                    <InputNumber @bind-Value="@orderModel.Total" class="form-control" placeholder="0.00" />
                                </div>
                                <div class="text-danger small mt-2 fw-bold">
                                    <ValidationMessage For="@(() => orderModel.Total)" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm">
                                🚀 Confirmer et publier l'événement
                            </button>
                        </EditForm>
                    </div>
                </div>

            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
            <div class="col-md-6 col-lg-5 col-xl-4">

                <div class="card shadow-lg border-0 rounded-3">
                    <div class="card-header bg-dark text-white text-center py-4">
                        <h4 class="m-0 fw-bold tracking-wide">🏢 Connexion Sécurisée</h4>
                        <small class="text-muted">MyCompany Microservices Platform</small>
                    </div>
                    <div class="card-body p-4 bg-white">

                        <EditForm Model="@loginModel" OnValidSubmit="ExecuteLogin" Context="loginContext">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Adresse Email</label>
                                <InputText @bind-Value="@loginModel.Email" type="email" class="form-control form-control-lg" placeholder="oualid@company.com" />
                                <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary">Mot de passe</label>
                                <InputText @bind-Value="@loginModel.Password" type="password" class="form-control form-control-lg" placeholder="••••••••" />
                                <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 py-2 shadow-sm fw-bold">
                                Se connecter
                            </button>
                        </EditForm>

                        @if (!string.IsNullOrEmpty(authError))
                        {
                            <div class="alert alert-danger mt-3 border-0 small shadow-sm">
                                ⚠️ @authError
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string authError = "";
    private OrderFormModel orderModel = new();
    private LoginFormModel loginModel = new();

    private async Task ExecuteLogin()
    {
        authError = "";
        System.Console.WriteLine("=== [CLICK] ExecuteLogin détecté ! ===");

        try
        {
            // 🟢 On utilise le client qui pointe vers la Gateway (localhost:5280)
            var client = HttpClientFactory.CreateClient("GatewayClient");

            var response = await client.PostAsJsonAsync("auths/login", new { Email = loginModel.Email, Password = loginModel.Password });

            if (response.IsSuccessStatusCode)
            {
                // 🟢 Utilisation explicite de ton nouveau DTO nettoyé
                var loginResult = await response.Content.ReadFromJsonAsync<MyCompany.Frontend.Web.Models.LoginResponseDto>();

                if (loginResult != null && !string.IsNullOrEmpty(loginResult.Token))
                {
                    await AuthService.LoginAsync(loginModel.Email, loginModel.Password, loginResult.Token);

                    var customStateProvider = AuthProvider as MyCompany.Frontend.Web.Security.CustomAuthStateProvider;
                    if (customStateProvider != null)
                    {
                        await Task.Run(() => customStateProvider.NotifyUserAuthentication(loginResult.Token));
                    }

                    Toast.ShowSuccess("Ravi de vous revoir ! 👋");
                    StateHasChanged();
                }
                else
                {
                    authError = "Erreur lors de la lecture du jeton d'accès.";
                }
            }
            else
            {
                authError = "Identifiants invalides ou compte inexistant.";
            }
        }
        catch (Exception ex)
        {
            authError = $"Erreur réseau ou Gateway injoignable : {ex.Message}";
        }
    }

    private async Task HandleValidSubmit()
    {
        Toast.ShowInfo("Publication de la commande via YARP...");

        var response = await Http.PostAsJsonAsync("orders", new { Total = orderModel.Total });

        if (response.IsSuccessStatusCode)
        {
            Toast.ShowSuccess($"Commande de {orderModel.Total:F2} € enregistrée avec succès !");
            orderModel = new OrderFormModel();
        }
        else
        {
            Toast.ShowError($"Échec de la création (HTTP {response.StatusCode})");
        }
    }

    public class LoginFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "L'adresse email est requise.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Format d'email invalide.")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le mot de passe est requis.")]
        public string Password { get; set; } = "";
    }
}